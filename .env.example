# Telegram core (same token/app as the old bot - do not create a new one)
APP_ID=
APP_HASH=
BOT_TOKEN=
OWNER=

# Telethon session file name. Must stay different from the old bot's "main"
# session (main.session) for as long as both bots' code exists on the same
# host - starting this bot with the old bot's session name while the old bot
# is running against the same token will break the old bot's live session.
SESSION_NAME=v2

# Database (same DSN/schema as the old bot; prod is MySQL, local dev can use sqlite)
DB_DSN=sqlite:///database.sqlite3

# Credits / VIP
ENABLE_VIP=true
FREE_DOWNLOAD=3
FREE_BANDWIDTH=2147483648
# Credits are volume-based: 1 credit per MB_PER_CREDIT MB delivered in a request
# (summed over all parts, rounded up, minimum 1). 200 = old bot; set 100 to
# make credits twice as expensive.
MB_PER_CREDIT=200

# Parallel upload lanes per file, 1..5 (default 5; above 5 is clamped to 5).
# Faster uploads of big files, but more requests/second = higher FLOOD_WAIT
# risk. Repeated flood waits lower the lanes automatically. 1 = sequential.
UPLOAD_WORKERS=5

# Real TCP connections per upload, 1..5 (default 5; clamped to 5 and to
# UPLOAD_WORKERS). Telegram caps bandwidth per connection, so this is what
# actually multiplies speed; 1 = all lanes share the main connection. If the
# extra connections cannot be opened the upload silently falls back to it.
# More connections = higher FLOOD_WAIT risk.
UPLOAD_CONNECTIONS=5

# Flood sleep threshold in seconds (default 0, matching Kraken).
# 0 allows flood errors to bubble up immediately to custom lane reduction
# and retry logic instead of sleeping silently in Telethon for up to 60s.
# Set to 60 to revert to Telethon's internal sleeping behavior.
FLOOD_SLEEP_THRESHOLD=0

# Archive channel to forward successful downloads to (numeric chat id or @username)
ARCHIVE_CHANNEL=

# Local scratch directory for in-flight downloads (each file is deleted
# after it is uploaded, whether the upload succeeds or fails)
DOWNLOAD_DIR=downloads

# Logging
LOG_FILE=logs/bot.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
# Also write logs to stdout (shown by journalctl under systemd). true/false
LOG_TO_CONSOLE=true

# Providers and Extraction Layer (M3)
# Comma-separated list defining priority order for TikTok and YouTube providers
TIKTOK_PROVIDERS=tikwm,tikdownloader,musicaldown,cobalt
YOUTUBE_PROVIDERS=ytmp3,cobalt
# Globally disabled providers (e.g. cobalt,musicaldown)
DISABLED_PROVIDERS=
# Public or private cobalt instance URL (e.g. https://cobalt.example.com)
COBALT_URL=
# Fixed API key for ytmp3.gl (gamma.gammacloud.net)
YTMP3_API_KEY=9b0ed5dab31616027ad7154140b0272d
# HTTP request timeout per provider in seconds
PROVIDER_TIMEOUT=15.0
# Consecutive failure count before suppressing provider
PROVIDER_FAILURE_THRESHOLD=3
# Cooldown duration in seconds before retrying a suppressed provider
PROVIDER_COOLDOWN_SECONDS=300
# Optional cookie file for TikTok
TIKTOK_COOKIES_FILE=

# YouTube / yt-dlp network and JS-runtime options (see docs/DEPLOY.md section 2)
# Force outbound connections over IPv4 (workaround for hosts with broken IPv6 routing to YouTube)
FORCE_IPV4=false
# Optional cookie file for YouTube (age-restricted/private videos, bot-detection workarounds)
YOUTUBE_COOKIES_FILE=
# Static PO token (see docs/DEPLOY.md section 2.2, Option B). Leave unset if using
# a self-hosted PO token provider (Option A) instead.
POTOKEN=
# Base URL of a self-hosted PO token provider server (e.g. bgutil-ytdlp-pot-provider).
# Only used by `media_bot_v2.preflight` to verify the server responds before cutover.
POTOKEN_PROVIDER_URL=
# Innertube player client sequence override (default depends on whether cookies are set;
# see resolve_player_client() in media_bot_v2/engines/youtube.py)
YOUTUBE_PLAYER_CLIENT=
# JS runtimes yt-dlp-ejs may use to solve YouTube signatures, comma-separated (default: deno,node)
YOUTUBE_JS_RUNTIMES=
# Remote solver components for yt-dlp-ejs, comma-separated (default: none; yt-dlp-ejs
# bundles solver scripts locally, so this is only needed to opt into fetching from GitHub/npm)
YOUTUBE_REMOTE_COMPONENTS=

# Concurrency limits
# Max concurrent downloads across all users. NOTE: this (and USER_WORKERS
# below) only gates how many requests may be *in flight* - the actual
# ceiling on the blocking work inside a request (download, mp3 conversion,
# ffprobe, split, upload part I/O) is THREAD_POOL_SIZE below. Raising WORKERS
# without also raising THREAD_POOL_SIZE changes nothing; see its comment.
WORKERS=100
# Max concurrent downloads per user (default 5; was 2 - too low a cap here
# queued a single active user behind their own limit while WORKERS=100 sat
# mostly idle. 5 gives one user real headroom without letting them
# monopolize the global pool).
USER_WORKERS=5
# The real concurrency ceiling for download/mp3-conversion/ffprobe/split/
# upload-part-read work. Python's asyncio.to_thread() alone schedules onto
# the event loop's *default* executor, sized to min(32, cpu_count()+4) - 10
# threads on a 6-core box - regardless of WORKERS/USER_WORKERS above; this
# project routes that work through its own dedicated thread pool
# (media_bot_v2/executor.py) sized by THREAD_POOL_SIZE instead, so THIS is
# the setting that actually controls how many downloads/conversions/splits
# run at once. Default 48.
THREAD_POOL_SIZE=48
# Account-health ceiling on concurrent *uploads* (not downloads), process-
# wide. Each upload can open up to UPLOAD_CONNECTIONS (default 5) real TCP
# connections to Telegram; with WORKERS=100 that is a theoretical 500
# simultaneous connections from one account, which raises FLOOD_WAIT risk
# for no throughput gain (Telegram's bandwidth cap - not connection count -
# is what actually limits upload speed; 60 concurrent uploads share the same
# bandwidth as 20). This semaphore only gates the upload step, never
# download/conversion concurrency. Default 20.
UPLOAD_CONCURRENCY_LIMIT=20

